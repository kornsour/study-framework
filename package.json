{
	"name": "typescript-template",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm db:migrate:deploy; fi && pnpm build",
		"start": "next start",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"bootstrap": "bash scripts/bootstrap.sh",
		"preflight": "bash scripts/preflight.sh",
		"db:local": "bash scripts/db-local.sh",
		"db:generate": "dotenv -e .env -- drizzle-kit generate",
		"db:migrate": "dotenv -e .env -- drizzle-kit migrate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:push": "dotenv -e .env -- drizzle-kit push",
		"db:studio": "dotenv -e .env -- drizzle-kit studio",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"verify": "bash scripts/verify.sh",
		"hooks:install": "node scripts/install-hooks.mjs",
		"aws:diff": "sst diff --stage production",
		"aws:deploy": "sst deploy --stage production"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.117.1",
		"@aws-sdk/client-sesv2": "^3.1110.0",
		"@neondatabase/serverless": "^1.1.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"better-auth": "^1.7.2",
		"docx": "^9.7.1",
		"drizzle-orm": "^0.45.2",
		"next": "16.3.3",
		"next-safe-action": "^8.6.1",
		"pg": "^8.23.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"stripe": "^22.5.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/pg": "^8.23.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.10",
		"sst": "^4.17.1",
		"tailwindcss": "^4",
		"typescript": "^7",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "0.28.1",
			"postcss": "8.5.26",
			"sharp": "0.35.0",
			"vite": "8.0.16"
		}
	}
}
